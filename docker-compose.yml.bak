version: '3.8'

services:

  sqlserver:
    image: mcr.microsoft.com/mssql/server:2022-latest
    container_name: agremiacion_sqlserver
    environment:
      SA_PASSWORD: "Admin@12345!"
      ACCEPT_EULA: "Y"
      MSSQL_PID: "Express"
    ports:
      - "1433:1433"
    volumes:
      - sqlserver_data:/var/opt/mssql
    networks:
      - agremiacion_net
    healthcheck:
      test: ["CMD-SHELL", "/opt/mssql-tools/bin/sqlcmd -S localhost -U SA -P 'Admin@12345!' -Q 'SELECT 1' || exit 1"]
      interval: 15s
      timeout: 10s
      retries: 5

  api:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: agremiacion_api
    ports:
      - "8080:8080"
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=AgremiacionComercio;User Id=sa;Password=Admin@12345!;TrustServerCertificate=True;
      - Jwt__Key=AgremiacionComercio_SuperSecretKey_2026_MustBeAtLeast32Chars!
      - Jwt__Issuer=AgremiacionComercio.API
      - Jwt__Audience=AgremiacionComercio.Client
      - Cors__AllowedOrigins__0=http://localhost:3000
      - Cors__AllowedOrigins__1=http://localhost:4200
    depends_on:
      sqlserver:
        condition: service_healthy
    networks:
      - agremiacion_net
    restart: on-failure

networks:
  agremiacion_net:
    driver: bridge

volumes:
  sqlserver_data:
